# Offline demos/tests do not need .env. Never commit the local .env file.
# Live mode is opt-in; use a model supporting Responses structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=

# Hosted deployment only; local app/main.py uses your existing prepared data.
# Configure these in platform secrets/variables; see docs/deployment.md.
# ASSET_BUNDLE_URL=https://your-file-host/runtime-assets.zip
# ASSET_BUNDLE_SHA256=sha256-printed-by-export-script
